# Per-cluster secret template for starmoe-status-agent
# Encrypt with SOPS or apply as Secret `starmoe-status-agent-secret` in namespace `monitoring`.
# Never commit real tokens or private infrastructure URLs.

# Cluster identifier: DE | JP1 | JP2 | US
CLUSTER_NAME=DE

# Central status server heartbeat endpoint
STATUS_INGEST_URL=https://status.star.moe/api/ingest/heartbeat

# Per-cluster bearer token (matches CLUSTER_TOKEN_<CLUSTER> on the server)
CLUSTER_TOKEN=replace-with-per-cluster-token

# Local VictoriaMetrics instant query base URL
VM_URL=http://vm.monitoring.svc.cluster.local:8428

# Heartbeat interval (default: 60s)
POLL_INTERVAL=60s

# Enable read-only ArgoCD Application checks (true on DE, false elsewhere)
ENABLE_ARGOCD=false

# Optional extra mount point to verify via VictoriaMetrics node_filesystem metrics (e.g. /mnt/extra-storage on DE)
EXTRA_MOUNT_PATH=
# Optional expected device for EXTRA_MOUNT_PATH (e.g. /dev/vdb1 on DE)
EXTRA_MOUNT_DEVICE=

# Optional comma-separated pod/deployment exclusions: "namespace/namePrefix,..."
# Defaults already include legacy excluded workloads from docs/design.md §4.3.
EXCLUDE_WORKLOADS=

# Optional JSON array of per-cluster deep health checks.
# Supported kinds: sekai_health | masterdata_sync | meta_builder | story_search | http | tcp | pod_alive
# Example:
# DEEP_CHECKS_JSON=[{"id":"seaweedfs","kind":"http","url":"http://seaweedfs-master.dev.svc.cluster.local:9333/cluster/healthz"}]
DEEP_CHECKS_JSON=[]
