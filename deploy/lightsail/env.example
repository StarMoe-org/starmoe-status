# StarMoe Status server environment configuration
# Copy to /etc/starmoe-status/env (chmod 0600, chown starmoe:starmoe).
# Never commit real tokens or secrets to Git.

# --- Core server ---
LISTEN_ADDR=127.0.0.1:8080
DB_PATH=/var/lib/starmoe-status/status.db
MONITORS_CONFIG=/etc/starmoe-status/monitors.yaml
PUBLIC_BASE_URL=https://status.star.moe

# --- Per-cluster agent ingestion tokens ---
# Generate with: openssl rand -hex 32
# You may provide raw tokens or sha256:<hex> hashes depending on server config.
CLUSTER_TOKEN_DE=replace-with-random-token-de
CLUSTER_TOKEN_JP1=replace-with-random-token-jp1
CLUSTER_TOKEN_JP2=replace-with-random-token-jp2
CLUSTER_TOKEN_US=replace-with-random-token-us

# --- Moebot plugin SSE & query API token ---
BOT_TOKEN=replace-with-random-bot-token

# --- Admin authentication (Cloudflare Access JWT) ---
# Team domain (e.g. https://<your-team>.cloudflareaccess.com) and application AUD tag.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Optional local/dev fallback bearer token (leave empty in production when CF Access is active).
ADMIN_DEV_TOKEN=

# --- Optional email alerting ---
# Policy: off | fallback | p0_always
EMAIL_POLICY=off
EMAIL_FROM=status@star.moe
# Comma-separated recipient addresses
EMAIL_TO=ops@star.moe
# Resend HTTPS API (takes precedence when RESEND_API_KEY is set)
RESEND_API_KEY=
# SMTPS / STARTTLS fallback (used when RESEND_API_KEY is empty and SMTP_HOST is set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Optional timing overrides (seconds) ---
PROBE_INTERVAL_SEC=60
HEARTBEAT_DEGRADED_SEC=120
HEARTBEAT_DOWN_SEC=180

# --- Optional external Dead-Man's-Switch reverse heartbeat (e.g. Healthchecks.io) ---
HEALTHCHECK_PING_URL=
